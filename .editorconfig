cat > .editorconfig <<'EOF'
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.cs]
indent_size = 4
dotnet_sort_system_directives_first = true
csharp_using_directive_placement = outside_namespace:suggestion
csharp_style_namespace_declarations = file_scoped:suggestion
csharp_prefer_braces = true:suggestion
csharp_style_var_when_type_is_apparent = true:suggestion
csharp_style_var_elsewhere = false:suggestion
dotnet_style_readonly_field = true:suggestion

dotnet_naming_rule.interfaces_should_have_i.severity = warning
dotnet_naming_rule.interfaces_should_have_i.symbols = interfaces
dotnet_naming_rule.interfaces_should_have_i.style = interface_style

dotnet_naming_symbols.interfaces.applicable_kinds = interface

dotnet_naming_style.interface_style.required_prefix = I
dotnet_naming_style.interface_style.capitalization = pascal_case

[*.{ts,tsx,js,jsx}]
indent_size = 2

[*.{json,jsonc,css,scss,html,yml,yaml}]
indent_size = 2

[*.{csproj,slnx,props,targets,xml}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false
EOF
